{
  "name": "@tt-players/ranking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node ./scripts/prepare-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "pnpm run build && npm pack ./dist --dry-run",
    "smoke:consumer": "node ./scripts/consumer-smoke.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
