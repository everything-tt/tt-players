{
  "name": "tt-players",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "pnpm --filter @tt-players/mobile build",
    "dev": "pnpm -r --parallel --filter @tt-players/api --filter @tt-players/mobile dev",
    "db:migrate": "pnpm --filter @tt-players/db run db:migrate",
    "db:migrate:down": "pnpm --filter @tt-players/db run db:migrate:down",
    "db:seed": "pnpm --filter @tt-players/db run db:seed",
    "test": "pnpm run test:backend",
    "test:backend": "pnpm --filter @tt-players/db test && pnpm --filter @tt-players/api test && pnpm --filter @tt-players/worker test && pnpm run test:performance-tools",
    "test:performance-tools": "node --test scripts/__tests__/*.test.mjs",
    "typecheck:backend": "pnpm --filter @tt-players/api... build && pnpm --filter @tt-players/worker build",
    "check:backend": "pnpm run typecheck:backend && pnpm run test:backend",
    "check:design-system": "node scripts/check-design-system-usage.mjs",
    "perf:api": "node scripts/benchmark-api.mjs",
    "perf:plans": "node scripts/capture-query-plans.mjs",
    "api:test": "pnpm --filter @tt-players/api run test",
    "mobile:dev": "pnpm --filter @tt-players/mobile run dev",
    "mobile:build": "pnpm --filter @tt-players/mobile run build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
