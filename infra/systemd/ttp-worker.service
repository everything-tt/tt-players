[Unit]
Description=TT Players Graphile Worker (ETL)
After=network-online.target postgresql.service ttp-api.service
Wants=network-online.target

[Service]
Type=simple
User=ttp
Group=ttp
WorkingDirectory=/opt/tt-players/current/apps/worker
EnvironmentFile=/etc/ttp/worker.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/ttp
Environment=DB_POOL_MAX=2
Environment=DB_STATEMENT_TIMEOUT_MS=60000
Environment=DB_QUERY_TIMEOUT_MS=65000
Environment=DB_LOCK_TIMEOUT_MS=5000
Environment=DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
Environment=DB_APPLICATION_NAME=tt-players-worker-data
Environment=GRAPHILE_POOL_MAX=3
Environment=GRAPHILE_STATEMENT_TIMEOUT_MS=60000
Environment=GRAPHILE_QUERY_TIMEOUT_MS=65000
Environment=GRAPHILE_APPLICATION_NAME=tt-players-worker-queue
Environment=WORKER_CONCURRENCY=1
ExecStart=/opt/tt-players/current/apps/worker/node_modules/.bin/tsx src/worker.ts
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=45
Nice=10
CPUAccounting=true
IOAccounting=true
MemoryAccounting=true
CPUWeight=20
IOWeight=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/tt-players

[Install]
WantedBy=multi-user.target
