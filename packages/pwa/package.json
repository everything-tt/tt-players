{
  "name": "@tt-players/pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node ./scripts/prepare-package.mjs",
    "test": "vitest run",
    "pack:check": "pnpm run build && npm pack ./dist --dry-run"
  },
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite.ts"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "vite-plugin-pwa": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
