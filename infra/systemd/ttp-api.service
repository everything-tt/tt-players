[Unit]
Description=TT Players API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ttp
Group=ttp
WorkingDirectory=/opt/tt-players/current/apps/api
EnvironmentFile=/etc/ttp/api.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/ttp
ExecStart=/opt/tt-players/current/apps/api/node_modules/.bin/tsx src/server.ts
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/tt-players

[Install]
WantedBy=multi-user.target
