[Unit]
Description=TT Players API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ttp
Group=ttp
WorkingDirectory=/opt/tt-players/current/apps/api
EnvironmentFile=/etc/ttp/api.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/ttp
Environment=DB_POOL_MAX=12
Environment=DB_STATEMENT_TIMEOUT_MS=10000
Environment=DB_QUERY_TIMEOUT_MS=12000
Environment=DB_LOCK_TIMEOUT_MS=1000
Environment=DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
Environment=DB_APPLICATION_NAME=tt-players-api
Environment=API_SLOW_REQUEST_MS=1000
ExecStart=/opt/tt-players/current/apps/api/node_modules/.bin/tsx src/server.ts
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
CPUAccounting=true
IOAccounting=true
MemoryAccounting=true
CPUWeight=200
IOWeight=200
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/tt-players

[Install]
WantedBy=multi-user.target
